        "liquid_ByEneR": {
          "type": "liquid",
          "settings": {
            "liquid": "<!-- ⭐ Rating Widget - Flydeka -->\n<div class=\"fdk-rating\" data-rating=\"4.8\" data-count=\"1067\" aria-label=\"Rated 4.8 out of 5 from 40 verified reviews\">\n  <div class=\"fdk-stars\" aria-hidden=\"true\">\n    <div class=\"fdk-stars-bg\">★★★★★</div>\n    <div class=\"fdk-stars-fill\">★★★★★</div>\n  </div>\n\n  <div class=\"fdk-meta\">\n    <span class=\"fdk-score\"><strong class=\"fdk-score-num\">4.8</strong>/5</span>\n    <span class=\"fdk-sep\">•</span>\n    <span class=\"fdk-verified\">\n      <svg class=\"fdk-check\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"currentColor\" aria-hidden=\"true\">\n        <path d=\"M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z\"/>\n      </svg>\n      <span class=\"fdk-count\">40</span> verified reviews\n    </span>\n  </div>\n</div>\n\n<style>\n  .fdk-rating{--star-size:22px;--star-gap:4px;--fill:#0FB56D;--bg:#E5E7EB;--text:#111827;--muted:#6B7280;--font:system-ui,-apple-system,Segoe UI,Roboto,Inter,Arial,sans-serif;--fill-width:0%;}\n  .fdk-rating{display:inline-flex;flex-direction:column;gap:6px;font-family:var(--font);color:var(--text)}\n  .fdk-stars{position:relative;display:inline-block;line-height:1}\n  .fdk-stars-bg,.fdk-stars-fill{font-size:var(--star-size);letter-spacing:var(--star-gap);font-weight:700}\n  .fdk-stars-bg{color:var(--bg)}\n  .fdk-stars-fill{color:var(--fill);position:absolute;left:0;top:0;overflow:hidden;width:var(--fill-width);white-space:nowrap}\n  .fdk-meta{display:flex;align-items:center;gap:8px;font-size:14px}\n  .fdk-score strong{font-weight:800}\n  .fdk-sep{color:var(--bg)}\n  .fdk-verified{color:var(--muted);display:inline-flex;align-items:center;gap:6px}\n  .fdk-check{color:var(--fill)}\n  /* Dark mode optional */\n  @media (prefers-color-scheme: dark){\n    .fdk-rating{--bg:#374151;--text:#F9FAFB;--muted:#D1D5DB}\n  }\n</style>\n\n<script>\n  // Auto-calc fill width & inject numbers from data-attributes\n  (function(){\n    document.querySelectorAll('.fdk-rating').forEach(el=>{\n      const rating = parseFloat(el.dataset.rating||'0');\n      const count  = parseInt(el.dataset.count||'0',10);\n      const percent = Math.max(0, Math.min(100, (rating/5)*100));\n      el.style.setProperty('--fill-width', percent + '%');\n      const scoreEl = el.querySelector('.fdk-score-num');\n      const countEl = el.querySelector('.fdk-count');\n      if(scoreEl) scoreEl.textContent = rating.toFixed(1);\n      if(countEl) countEl.textContent = new Intl.NumberFormat('fr-FR').format(count);\n    });\n  })();\n</script>"
